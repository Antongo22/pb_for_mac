<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PbForMac.App"
             xmlns:local="using:PbForMac"
             Name="PbForMac"
             RequestedThemeVariant="Default">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WorkspaceBrush" Color="#EAEAEA" />
          <SolidColorBrush x:Key="PageBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PanelBrush" Color="#F7F7F7" />
          <SolidColorBrush x:Key="DividerBrush" Color="#E1DFDD" />
          <SolidColorBrush x:Key="SubtleTextBrush" Color="#605E5C" />
          <SolidColorBrush x:Key="ChipBrush" Color="#EDEBE9" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#A4262C" />
          <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FDE7E9" />
          <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#E6F2FB" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WorkspaceBrush" Color="#161514" />
          <SolidColorBrush x:Key="PageBrush" Color="#252423" />
          <SolidColorBrush x:Key="PanelBrush" Color="#201F1E" />
          <SolidColorBrush x:Key="DividerBrush" Color="#3B3A39" />
          <SolidColorBrush x:Key="SubtleTextBrush" Color="#A19F9D" />
          <SolidColorBrush x:Key="ChipBrush" Color="#323130" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#F1707B" />
          <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#442726" />
          <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#1F3347" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <SolidColorBrush x:Key="RailBrush" Color="#252423" />
      <SolidColorBrush x:Key="RailHoverBrush" Color="#3B3A39" />
      <SolidColorBrush x:Key="BrandBrush" Color="#F2C811" />
      <SolidColorBrush x:Key="SelectionBrush" Color="#118DFF" />

      <!-- Иконки: Material Design Icons (Apache License 2.0) и простые собственные фигуры. -->
      <StreamGeometry x:Key="IconReport">M4,20 V12 H8 V20 Z M10,20 V5 H14 V20 Z M16,20 V9 H20 V20 Z</StreamGeometry>
      <StreamGeometry x:Key="IconData">M3,4 H21 V20 H3 Z M5,9 V12 H11 V9 Z M13,9 V12 H19 V9 Z M5,14 V18 H11 V14 Z M13,14 V18 H19 V14 Z</StreamGeometry>
      <StreamGeometry x:Key="IconModel">M3,3 H10 V8 H3 Z M14,10 H21 V15 H14 Z M3,17 H10 V22 H3 Z M6,8 H7 V17 H6 Z M7,12 H14 V13 H7 Z</StreamGeometry>
      <StreamGeometry x:Key="IconNew">M6 2c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6H6zm7 7V3.5L18.5 9H13z</StreamGeometry>
      <StreamGeometry x:Key="IconOpen">M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z</StreamGeometry>
      <StreamGeometry x:Key="IconSave">M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z</StreamGeometry>
      <StreamGeometry x:Key="IconDatabase">M2 20h20v-4H2v4zm2-3h2v2H4v-2zM2 4v4h20V4H2zm4 3H4V5h2v2zm-4 7h20v-4H2v4zm2-3h2v2H4v-2z</StreamGeometry>
      <StreamGeometry x:Key="IconRefresh">M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>
      <StreamGeometry x:Key="IconImage">M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z</StreamGeometry>
      <StreamGeometry x:Key="IconDelete">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
      <StreamGeometry x:Key="IconCopy">M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z</StreamGeometry>
      <StreamGeometry x:Key="IconClose">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
      <StreamGeometry x:Key="IconFilter">M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z</StreamGeometry>
      <StreamGeometry x:Key="IconDownload">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</StreamGeometry>
      <StreamGeometry x:Key="IconFolder">M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
      <StreamGeometry x:Key="IconFile">M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z</StreamGeometry>
      <StreamGeometry x:Key="IconAdd">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://PbForMac/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
