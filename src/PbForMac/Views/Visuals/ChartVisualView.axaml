<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vis="using:PbForMac.ViewModels.Visuals"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="PbForMac.Views.Visuals.ChartVisualView"
             x:DataType="vis:ChartVisualViewModel">
  <Grid>
    <lvc:CartesianChart IsVisible="{Binding IsCartesian}"
                        Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                        LegendPosition="{Binding LegendPosition}" LegendTextPaint="{Binding LegendTextPaint}"
                        LegendTextSize="11" TooltipPosition="Top" AnimationsSpeed="00:00:00.300" />
    <lvc:PieChart IsVisible="{Binding IsPie}"
                  Series="{Binding Series}"
                  LegendPosition="{Binding LegendPosition}" LegendTextPaint="{Binding LegendTextPaint}"
                  LegendTextSize="11" TooltipPosition="Center" AnimationsSpeed="00:00:00.300" />
  </Grid>
</UserControl>
