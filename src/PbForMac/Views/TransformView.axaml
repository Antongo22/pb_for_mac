<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PbForMac.ViewModels"
             xmlns:controls="using:PbForMac.Controls"
             x:Class="PbForMac.Views.TransformView"
             x:DataType="vm:TransformViewModel">

  <Grid>
    <StackPanel IsVisible="{Binding !HasTables}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
      <PathIcon Data="{StaticResource IconModel}" Width="48" Height="48" Foreground="{DynamicResource SubtleTextBrush}" />
      <TextBlock Text="Модель пуста" FontSize="18" HorizontalAlignment="Center" />
      <TextBlock Classes="hint" HorizontalAlignment="Center" Text="Загрузите данные, чтобы добавлять вычисляемые столбцы, группировки и фильтры." />
    </StackPanel>

    <Grid IsVisible="{Binding HasTables}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270" MinWidth="200" MaxWidth="600" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="300" MinWidth="220" MaxWidth="700" />
      </Grid.ColumnDefinitions>

      <!-- Таблица и столбцы -->
      <Border Classes="pane" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Classes="paneHeader" Text="Таблица" />
            <ComboBox ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
              <TextBlock Classes="caption" Text="Столбцы" Margin="0" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="icon" Command="{Binding SelectAllColumnsCommand}"
                      ToolTip.Tip="Отметить / снять все">
                <TextBlock Text="☑" FontSize="14" />
              </Button>
            </Grid>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
            <StackPanel IsVisible="{Binding HasCheckedColumns}" Spacing="6">
              <TextBlock Classes="caption" Text="{Binding CheckedColumnCount, StringFormat=Отмечено: {0}}" />
              <Button HorizontalAlignment="Stretch" Command="{Binding RemoveCheckedColumnsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconDelete}" Width="12" Height="12" />
                  <TextBlock Text="Удалить отмеченные" />
                </StackPanel>
              </Button>
              <Button HorizontalAlignment="Stretch" Command="{Binding KeepCheckedColumnsCommand}"
                      ToolTip.Tip="Оставить только отмеченные столбцы, остальные удалить">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconFilter}" Width="12" Height="12" />
                  <TextBlock Text="Оставить только отмеченные" />
                </StackPanel>
              </Button>
            </StackPanel>
            <StackPanel IsVisible="{Binding HasColumn}" Spacing="6">
              <TextBlock Classes="caption" Text="Выбранный столбец" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding NewColumnName}" Watermark="Новое имя" />
                <Button Grid.Column="1" Margin="6,0,0,0" Content="Переименовать" Command="{Binding RenameColumnCommand}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <ComboBox ItemsSource="{Binding ColumnTypes}" SelectedItem="{Binding TargetType}" />
                <Button Grid.Column="1" Margin="6,0,0,0" Content="Сменить тип" Command="{Binding ChangeTypeCommand}" />
              </Grid>
              <Grid ColumnDefinitions="*,*" Margin="0,0,0,0">
                <Button Content="← Влево" Command="{Binding MoveColumnLeftCommand}"
                        ToolTip.Tip="Переместить столбец левее" />
                <Button Grid.Column="1" Margin="6,0,0,0" Content="Вправо →" Command="{Binding MoveColumnRightCommand}"
                        ToolTip.Tip="Переместить столбец правее" />
              </Grid>
              <Button HorizontalAlignment="Stretch" Command="{Binding ReplaceValuesCommand}"
                      ToolTip.Tip="Как «Заменить значения» в Power Query">
                <TextBlock Text="Заменить значения…" />
              </Button>
              <Grid ColumnDefinitions="*,*">
                <Button Content="Заполнить ↓" Command="{Binding FillDownCommand}"
                        ToolTip.Tip="Заполнить пустые ячейки значением сверху" />
                <Button Grid.Column="1" Margin="6,0,0,0" Content="Заполнить ↑" Command="{Binding FillUpCommand}"
                        ToolTip.Tip="Заполнить пустые ячейки значением снизу" />
              </Grid>
              <Button HorizontalAlignment="Stretch" Command="{Binding SplitColumnCommand}"
                      ToolTip.Tip="Разделить текстовый столбец по разделителю">
                <TextBlock Text="Разделить столбец…" />
              </Button>
              <Button HorizontalAlignment="Stretch" Command="{Binding RemoveColumnCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconDelete}" Width="12" Height="12" />
                  <TextBlock Text="Удалить столбец" />
                </StackPanel>
              </Button>
            </StackPanel>
            <Button HorizontalAlignment="Stretch" Content="Удалить пустые строки" Command="{Binding RemoveBlankRowsCommand}"
                    ToolTip.Tip="Удалить строки, где все ячейки пусты" />
            <Button HorizontalAlignment="Stretch" Content="Удалить дубликаты строк" Command="{Binding RemoveDuplicatesCommand}" />
          </StackPanel>

          <ListBox ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn}" Background="Transparent">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Удалить столбец" Command="{Binding RemoveColumnCommand}" />
                <MenuItem Header="Удалить отмеченные" Command="{Binding RemoveCheckedColumnsCommand}" />
                <MenuItem Header="Оставить только отмеченные" Command="{Binding KeepCheckedColumnsCommand}" />
                <Separator />
                <MenuItem Header="Заменить значения…" Command="{Binding ReplaceValuesCommand}" />
                <MenuItem Header="Заполнить вниз" Command="{Binding FillDownCommand}" />
                <MenuItem Header="Заполнить вверх" Command="{Binding FillUpCommand}" />
                <MenuItem Header="Разделить столбец…" Command="{Binding SplitColumnCommand}" />
                <Separator />
                <MenuItem Header="Переместить влево" Command="{Binding MoveColumnLeftCommand}" />
                <MenuItem Header="Переместить вправо" Command="{Binding MoveColumnRightCommand}" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ColumnItem">
                <Grid ColumnDefinitions="Auto,24,*" Margin="0,1">
                  <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBlock Grid.Column="1" Text="{Binding TypeGlyph}" Foreground="{DynamicResource SubtleTextBrush}"
                             ToolTip.Tip="{Binding TypeLabel}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Инструменты преобразования -->
      <GridSplitter Grid.Column="1" Classes="paneSplitter" />

      <DockPanel Grid.Column="2" Margin="12">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
          <Border Classes="error" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Error}" />
          </Border>
          <Border Classes="info" IsVisible="{Binding Info, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Info}" />
          </Border>
        </StackPanel>

        <TabControl>
          <TabItem Header="Предпросмотр">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,6" Text="Первые 500 строк таблицы после всех шагов." />
              <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <controls:DataTableGrid Source="{Binding Preview}" ColumnActions="{Binding ColumnActions}" />
              </Border>
            </DockPanel>
          </TabItem>

          <TabItem Header="Вычисляемый столбец">
            <ScrollViewer>
              <StackPanel Spacing="8" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Classes="caption" Text="Имя нового столбца" />
                <TextBox Text="{Binding CalcName}" Watermark="Например, Выручка" />
                <TextBlock Classes="caption" Text="Выражение" />
                <TextBox Text="{Binding CalcExpression}" Watermark="[Цена] * [Количество]" AcceptsReturn="True"
                         MinHeight="70" TextWrapping="Wrap" FontFamily="Menlo, Consolas, monospace" />
                <TextBlock Classes="hint" Text="Нажмите на столбец, чтобы вставить его в выражение:" />
                <ItemsControl ItemsSource="{Binding Columns}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ColumnItem">
                      <Button Margin="0,0,6,6" Padding="8,2" FontSize="12" Command="{Binding Insert}" Content="{Binding Name}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="accent" Content="Добавить столбец" Command="{Binding AddCalculatedColumnCommand}" />
                <Border Classes="info" Margin="0,8,0,0">
                  <TextBlock Text="{Binding ExpressionHelp}" FontFamily="Menlo, Consolas, monospace" FontSize="12" />
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Группировка">
            <ScrollViewer>
              <Grid ColumnDefinitions="*,24,*" MaxWidth="820" HorizontalAlignment="Left">
                <StackPanel>
                  <TextBlock Classes="caption" Text="Группировать по" />
                  <ItemsControl ItemsSource="{Binding GroupColumns}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CheckItem">
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                  <TextBlock Classes="caption" Text="Агрегаты" />
                  <ComboBox ItemsSource="{Binding Columns}" SelectedValue="{Binding AggregationColumn}" SelectedValueBinding="{ReflectionBinding Name}" />
                  <ComboBox ItemsSource="{Binding Aggregations}" SelectedItem="{Binding AggregationKind}" />
                  <TextBox Text="{Binding AggregationName}" Watermark="Имя результата (необязательно)" />
                  <Button Content="Добавить агрегат" Command="{Binding AddAggregationCommand}" />
                  <ItemsControl ItemsSource="{Binding AggregationSpecs}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AggregationSpecItem">
                        <Border Classes="chip" HorizontalAlignment="Left">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Text}" FontSize="12" VerticalAlignment="Center" />
                            <Button Classes="icon" Command="{Binding Remove}">
                              <PathIcon Data="{StaticResource IconClose}" />
                            </Button>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="caption" Text="Имя новой таблицы" />
                  <TextBox Text="{Binding GroupTableName}" Watermark="Сформируется автоматически" />
                  <Button Classes="accent" Content="Создать таблицу" Command="{Binding CreateGroupByCommand}" />
                  <TextBlock Classes="hint" Text="Результат — новая таблица модели, которую можно использовать в визуалах." />
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Фильтр строк">
            <StackPanel Spacing="8" MaxWidth="520" HorizontalAlignment="Left">
              <TextBlock Classes="hint" Text="Оставить в таблице только строки, где:" />
              <ComboBox ItemsSource="{Binding Columns}" SelectedValue="{Binding FilterColumn}" SelectedValueBinding="{ReflectionBinding Name}" />
              <ComboBox ItemsSource="{Binding FilterOperators}" SelectedItem="{Binding SelectedOperator}" />
              <TextBox Text="{Binding FilterValue}" Watermark="Значение" IsEnabled="{Binding FilterNeedsValue}" />
              <Button Classes="accent" Content="Добавить шаг" Command="{Binding AddFilterStepCommand}" />
            </StackPanel>
          </TabItem>

          <TabItem Header="Связи">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                <TextBlock Classes="hint"
                           Text="Диаграмма модели: карточки таблиц и связи «многие к одному». Столбцы справочника доступны в визуалах фактов как «Таблица[Столбец]»; фильтры справочника фильтруют факты." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Command="{Binding DetectRelationshipsCommand}" Content="Найти связи автоматически" />
                  <Button Command="{Binding AutoLayoutDiagramCommand}" Content="Автораскладка"
                          ToolTip.Tip="Разложить таблицы по слоям: факты слева, справочники правее" />
                  <Button Command="{Binding RemoveSelectedDiagramLinkCommand}" Content="Удалить выбранную связь"
                          IsEnabled="{Binding SelectedDiagramLink, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <TextBlock Classes="hint" Text="{Binding DiagramHint}" IsVisible="{Binding DiagramHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>

              <Expander DockPanel.Dock="Bottom" Header="Добавить связь вручную" IsExpanded="{Binding !HasRelationships}" Margin="0,8,0,0">
                <StackPanel Spacing="8" Margin="0,8,0,0">
                  <Grid ColumnDefinitions="*,Auto,*">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="hint" Text="Многие — таблица фактов" />
                      <ComboBox ItemsSource="{Binding Tables}" SelectedItem="{Binding RelationshipFromTable}" />
                      <ComboBox ItemsSource="{Binding RelationshipFromColumns}" SelectedItem="{Binding RelationshipFromColumn}" PlaceholderText="Ключ" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="→" FontSize="20" Margin="14,22,14,0" VerticalAlignment="Center"
                               Foreground="{StaticResource SelectionBrush}" />
                    <StackPanel Grid.Column="2" Spacing="6">
                      <TextBlock Classes="hint" Text="Один — справочник (уникальный ключ)" />
                      <ComboBox ItemsSource="{Binding Tables}" SelectedItem="{Binding RelationshipToTable}" />
                      <ComboBox ItemsSource="{Binding RelationshipToColumns}" SelectedItem="{Binding RelationshipToColumn}" PlaceholderText="Ключ" />
                    </StackPanel>
                  </Grid>
                  <Button Classes="accent" Content="Добавить связь" Command="{Binding AddRelationshipCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Expander>

              <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Background="{DynamicResource WorkspaceBrush}"
                      MinHeight="360" CornerRadius="4" ClipToBounds="True">
                <controls:RelationshipDiagram x:Name="RelationshipDiagram"
                                             Tables="{Binding DiagramTables}"
                                             Links="{Binding DiagramLinks}"
                                             SelectedLink="{Binding SelectedDiagramLink}" />
              </Border>
            </DockPanel>
          </TabItem>
        </TabControl>
      </DockPanel>

      <!-- Применённые шаги -->
      <GridSplitter Grid.Column="3" Classes="paneSplitter" />

      <Border Grid.Column="4" Classes="pane" BorderThickness="1,0,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="paneHeader" Text="Применённые шаги" Margin="0" />
              <TextBlock Grid.Column="1" Classes="hint" Text="{Binding StepCountText}" VerticalAlignment="Center" />
            </Grid>
            <CheckBox Content="Только текущая таблица" IsChecked="{Binding FilterStepsByTable}"
                      IsVisible="{Binding HasSteps}" FontSize="12" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Classes="hint" IsVisible="{Binding !HasSteps}"
                     Text="Шагов пока нет. Каждое преобразование записывается сюда и повторяется при обновлении данных." />
          <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,6"
                     IsVisible="{Binding ShowFilteredStepsEmpty}"
                     Text="Для этой таблицы шагов нет. Снимите фильтр, чтобы увидеть все." />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding VisibleSteps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StepItemViewModel">
                  <Border Background="{DynamicResource PageBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,6"
                          BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                      <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Top" Margin="0,0,4,0"
                                ToolTip.Tip="Включить или выключить шаг (как в Power Query)" />
                      <TextBlock Grid.Column="1" Text="{Binding Number}" Classes="hint" Margin="0,2,6,0" />
                      <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="{Binding Table}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" />
                        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource ErrorBrush}" />
                      </StackPanel>
                      <Button Grid.Column="3" Classes="icon" VerticalAlignment="Top" Command="{Binding Remove}" ToolTip.Tip="Удалить шаг">
                        <PathIcon Data="{StaticResource IconDelete}" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
