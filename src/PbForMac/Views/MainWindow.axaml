<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PbForMac.ViewModels"
        xmlns:services="using:PbForMac.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="860"
        x:Class="PbForMac.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app.png"
        Title="{Binding Title}"
        Width="1440" Height="900" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="Файл">
        <NativeMenu>
          <NativeMenuItem Header="Новый отчёт" Command="{Binding NewReportCommand}" Gesture="Meta+N" />
          <NativeMenuItem Header="Открыть отчёт или данные…" Command="{Binding OpenReportCommand}" Gesture="Meta+O" />
          <NativeMenuItem Header="Открыть пример" Command="{Binding OpenSampleCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Сохранить" Command="{Binding SaveReportCommand}" Gesture="Meta+S" />
          <NativeMenuItem Header="Сохранить как…" Command="{Binding SaveReportAsCommand}" Gesture="Meta+Shift+S" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Экспорт дашборда в PNG…" Command="{Binding ExportPngCommand}" Gesture="Meta+E" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Данные">
        <NativeMenu>
          <NativeMenuItem Header="Получить данные из файлов…" Command="{Binding ImportCommand}" Gesture="Meta+I" />
          <NativeMenuItem Header="Получить данные из папки…" Command="{Binding ImportFolderCommand}" Gesture="Meta+Shift+I" />
          <NativeMenuItem Header="Обновить" Command="{Binding RefreshCommand}" Gesture="Meta+R" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Вид">
        <NativeMenu>
          <NativeMenuItem Header="Отчёт" Command="{Binding ShowReportCommand}" Gesture="Meta+D1" />
          <NativeMenuItem Header="Данные" Command="{Binding ShowDataCommand}" Gesture="Meta+D2" />
          <NativeMenuItem Header="Модель" Command="{Binding ShowModelCommand}" Gesture="Meta+D3" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Переключить тему" Command="{Binding ToggleThemeCommand}" Gesture="Meta+Shift+T" />
          <NativeMenuItem Header="Тема">
            <NativeMenu>
              <NativeMenuItem Header="Как в системе" ToggleType="Radio" IsChecked="{Binding IsSystemTheme}"
                              Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.System}" />
              <NativeMenuItem Header="Светлая" ToggleType="Radio" IsChecked="{Binding IsLightTheme}"
                              Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.Light}" />
              <NativeMenuItem Header="Тёмная" ToggleType="Radio" IsChecked="{Binding IsDarkThemeSelected}"
                              Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.Dark}" />
            </NativeMenu>
          </NativeMenuItem>
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="56,*">

    <!-- Панель инструментов -->
    <Border Grid.ColumnSpan="2" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,6,12,6">
      <Grid ColumnDefinitions="56,Auto,*,Auto">
        <Viewbox Width="24" Height="24" HorizontalAlignment="Center">
          <Canvas Width="24" Height="24">
            <Rectangle Canvas.Left="3" Canvas.Top="10" Width="5" Height="11" RadiusX="1" RadiusY="1" Fill="{StaticResource BrandBrush}" />
            <Rectangle Canvas.Left="9.5" Canvas.Top="6" Width="5" Height="15" RadiusX="1" RadiusY="1" Fill="#E8B200" />
            <Rectangle Canvas.Left="16" Canvas.Top="2" Width="5" Height="19" RadiusX="1" RadiusY="1" Fill="#C79A00" />
          </Canvas>
        </Viewbox>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Classes="tool" Command="{Binding NewReportCommand}" ToolTip.Tip="Новый отчёт">
            <StackPanel><PathIcon Data="{StaticResource IconNew}" /><TextBlock Text="Новый" /></StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding OpenReportCommand}" ToolTip.Tip="Открыть отчёт (.pbm) или файлы данных">
            <StackPanel><PathIcon Data="{StaticResource IconOpen}" /><TextBlock Text="Открыть" /></StackPanel>
          </Button>
          <SplitButton Command="{Binding SaveReportCommand}" Padding="8,4" Background="Transparent" BorderThickness="0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="16" Height="16" Data="{StaticResource IconSave}" />
              <TextBlock Text="Сохранить" />
            </StackPanel>
            <SplitButton.Flyout>
              <MenuFlyout>
                <MenuItem Header="Сохранить как…" Command="{Binding SaveReportAsCommand}" />
              </MenuFlyout>
            </SplitButton.Flyout>
          </SplitButton>
          <Rectangle Width="1" Height="22" Margin="8,0" Fill="{DynamicResource DividerBrush}" />
          <DropDownButton Padding="8,4" Background="Transparent" BorderThickness="0"
                          ToolTip.Tip="Файлы CSV, Excel, JSON, XML, SQLite или целая папка с подпапками">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="16" Height="16" Data="{StaticResource IconDatabase}" />
              <TextBlock Text="Получить данные" />
            </StackPanel>
            <DropDownButton.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Файлы…" Command="{Binding ImportCommand}">
                  <MenuItem.Icon><PathIcon Data="{StaticResource IconFile}" Width="14" Height="14" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Папка (с подпапками)…" Command="{Binding ImportFolderCommand}">
                  <MenuItem.Icon><PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" /></MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <Button Classes="tool" Command="{Binding RefreshCommand}" ToolTip.Tip="Перечитать все источники">
            <StackPanel><PathIcon Data="{StaticResource IconRefresh}" /><TextBlock Text="Обновить" /></StackPanel>
          </Button>
          <Rectangle Width="1" Height="22" Margin="8,0" Fill="{DynamicResource DividerBrush}" />
          <Button Classes="tool" Command="{Binding ExportPngCommand}" ToolTip.Tip="Сохранить дашборд как изображение">
            <StackPanel><PathIcon Data="{StaticResource IconImage}" /><TextBlock Text="Экспорт PNG" /></StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12">
          <TextBlock VerticalAlignment="Center" Classes="hint" Text="{Binding Title}" />
          <SplitButton Command="{Binding ToggleThemeCommand}" Padding="8,4" Background="Transparent" BorderThickness="0"
                       ToolTip.Tip="Переключить светлую / тёмную тему">
            <Panel>
              <PathIcon Width="16" Height="16" Data="{StaticResource IconMoon}" IsVisible="{Binding !IsDarkTheme}" />
              <PathIcon Width="16" Height="16" Data="{StaticResource IconSun}" IsVisible="{Binding IsDarkTheme}" />
            </Panel>
            <SplitButton.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Как в системе" ToggleType="Radio" GroupName="theme" IsChecked="{Binding IsSystemTheme, Mode=OneWay}"
                          Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.System}" />
                <MenuItem Header="Светлая" ToggleType="Radio" GroupName="theme" IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                          Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.Light}" />
                <MenuItem Header="Тёмная" ToggleType="Radio" GroupName="theme" IsChecked="{Binding IsDarkThemeSelected, Mode=OneWay}"
                          Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.Dark}" />
              </MenuFlyout>
            </SplitButton.Flyout>
          </SplitButton>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Навигация -->
    <StackPanel Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource RailBrush}">
      <Button Classes="nav" Classes.active="{Binding IsReportPage}" Command="{Binding ShowReportCommand}" ToolTip.Tip="Отчёт">
        <StackPanel Spacing="3">
          <PathIcon Data="{StaticResource IconReport}" Width="20" Height="20" />
          <TextBlock Text="Отчёт" />
        </StackPanel>
      </Button>
      <Button Classes="nav" Classes.active="{Binding IsDataPage}" Command="{Binding ShowDataCommand}" ToolTip.Tip="Данные">
        <StackPanel Spacing="3">
          <PathIcon Data="{StaticResource IconData}" Width="20" Height="20" />
          <TextBlock Text="Данные" />
        </StackPanel>
      </Button>
      <Button Classes="nav" Classes.active="{Binding IsModelPage}" Command="{Binding ShowModelCommand}" ToolTip.Tip="Модель">
        <StackPanel Spacing="3">
          <PathIcon Data="{StaticResource IconModel}" Width="20" Height="20" />
          <TextBlock Text="Модель" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Текущая страница -->
    <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" />

    <!-- Строка состояния -->
    <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,3">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ProgressBar IsIndeterminate="True" Width="80" MinWidth="80" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
          <TextBlock Classes="hint" Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="hint" Text="{Binding ModelSummary}" VerticalAlignment="Center"
                   Margin="16,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</Window>
