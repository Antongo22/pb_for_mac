<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PbForMac.ViewModels"
             xmlns:vis="using:PbForMac.ViewModels.Visuals"
             xmlns:views="using:PbForMac.Views"
             x:Class="PbForMac.Views.ReportView"
             x:DataType="vm:ReportViewModel"
             Focusable="True">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" MinWidth="160" MaxWidth="420" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" MinWidth="400" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="300" MinWidth="240" MaxWidth="600" />
    </Grid.ColumnDefinitions>

    <!-- Панель «Поля» (как в Power BI) -->
    <Border Grid.Column="0" Classes="pane" BorderThickness="0,0,1,0" Padding="0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="14,14,14,8" Spacing="4">
          <TextBlock Classes="paneHeader" Text="Поля" Margin="0" />
          <TextBlock Classes="hint"
                     Text="Клик или перетаскивание в колодец справа. Без выбранного визуала клик создаёт гистограмму." />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="14,0,14,8" IsVisible="{Binding !HasData}"
                   Text="Загрузите данные, чтобы увидеть таблицы и столбцы." />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding FieldTables}" Margin="8,0,8,14">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FieldTableNode">
                <StackPanel Margin="0,0,0,8">
                  <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Padding="6,4" Command="{Binding Toggle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="▾" FontSize="11" IsVisible="{Binding IsExpanded}"
                                 Foreground="{DynamicResource SubtleTextBrush}" />
                      <TextBlock Text="▸" FontSize="11" IsVisible="{Binding !IsExpanded}"
                                 Foreground="{DynamicResource SubtleTextBrush}" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                  </Button>
                  <ItemsControl ItemsSource="{Binding Columns}" IsVisible="{Binding IsExpanded}" Margin="12,0,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FieldColumnItem">
                        <Border Classes="flat" Padding="6,3" Cursor="Hand"
                                Background="Transparent"
                                PointerPressed="OnFieldPointerPressed"
                                ToolTip.Tip="Клик — назначить; перетащите в колодец категории или значений">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding TypeGlyph}" Width="14" FontSize="11"
                                       Foreground="{DynamicResource SubtleTextBrush}" />
                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <GridSplitter Grid.Column="1" Classes="paneSplitter" />

    <!-- Холст -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="8,4">
        <Grid ColumnDefinitions="*,Auto">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Pages}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ReportPageItem">
                  <Button Classes="flat pageTab" Classes.selected="{Binding IsSelected}"
                          Padding="10,4" MinWidth="80" Command="{Binding Select}">
                    <TextBlock Text="{Binding Name}" FontSize="12" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
            <Button Classes="icon" Command="{Binding ResetSlicersCommand}" ToolTip.Tip="Сбросить все срезы">
              <PathIcon Data="{StaticResource IconFilter}" Width="14" Height="14" />
            </Button>
            <Button Classes="icon" Command="{Binding AddBookmarkCommand}" ToolTip.Tip="Сохранить закладку (срезы и страница)">
              <PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14" />
            </Button>
            <Rectangle Width="1" Fill="{DynamicResource DividerBrush}" Margin="4,2" />
            <Button Classes="icon" Command="{Binding AddPageCommand}" ToolTip.Tip="Добавить страницу">
              <PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14" />
            </Button>
            <Button Classes="icon" Command="{Binding RenamePageCommand}" ToolTip.Tip="Переименовать страницу">
              <TextBlock Text="Aa" FontSize="11" FontWeight="SemiBold" />
            </Button>
            <Button Classes="icon" Command="{Binding DeletePageCommand}" IsEnabled="{Binding CanDeletePage}"
                    ToolTip.Tip="Удалить страницу">
              <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource WorkspaceBrush}">
      <LayoutTransformControl Margin="24" HorizontalAlignment="Left" VerticalAlignment="Top">
        <LayoutTransformControl.LayoutTransform>
          <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
        </LayoutTransformControl.LayoutTransform>
        <Panel>
      <Border x:Name="Board"
              Width="{Binding BoardWidth}" Height="{Binding BoardHeight}"
              Background="{Binding PageBackground, Converter={StaticResource HexBrush}, ConverterParameter=PageBrush}"
              BoxShadow="0 1 4 0 #33000000">
        <Grid>
          <ItemsControl ItemsSource="{Binding Visuals}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerTheme>
              <ControlTheme TargetType="ContentPresenter" x:DataType="vis:VisualViewModel">
                <Setter Property="Canvas.Left" Value="{Binding X}" />
                <Setter Property="Canvas.Top" Value="{Binding Y}" />
              </ControlTheme>
            </ItemsControl.ItemContainerTheme>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vis:VisualViewModel">
                <views:VisualTileView />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                      MaxWidth="460">
            <PathIcon Data="{StaticResource IconReport}" Width="56" Height="56" Foreground="{StaticResource BrandBrush}" />
            <TextBlock Text="Создайте свой первый отчёт" FontSize="20" HorizontalAlignment="Center" />
            <TextBlock Classes="hint" TextAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasData}"
                       Text="Загрузите данные из CSV, Excel, JSON, XML или SQLite либо откройте готовый пример." />
            <TextBlock Classes="hint" TextAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding HasData}"
                       Text="Выберите тип визуализации справа или кликните поле слева. Настройте оси в «Областях полей»." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding !HasData}">
              <Button Classes="accent" Content="Получить данные" Command="{Binding ImportCommand}" />
              <Button Content="Из папки" Command="{Binding ImportFolderCommand}" />
              <Button Content="Открыть пример" Command="{Binding OpenSampleCommand}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
        </Panel>
      </LayoutTransformControl>
    </ScrollViewer>

    <!-- Масштаб -->
    <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,16" Padding="8,2"
            CornerRadius="4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ToggleButton IsChecked="{Binding FitToWidth}" Content="По ширине" Padding="8,2" FontSize="12"
                      ToolTip.Tip="Автоматически подгонять страницу под ширину окна" />
        <Slider x:Name="ZoomSlider" Width="120" Minimum="0.3" Maximum="2" Value="{Binding Zoom}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ZoomText}" Width="40" VerticalAlignment="Center" FontSize="12" />
      </StackPanel>
    </Border>
    </Grid>

    <!-- Правая панель -->
    <GridSplitter Grid.Column="3" Classes="paneSplitter" />

    <Border Grid.Column="4" Classes="pane" BorderThickness="1,0,0,0" Padding="0">
      <ScrollViewer>
        <StackPanel Margin="14" Spacing="4">

          <TextBlock Classes="paneHeader" Text="Визуализации" />
          <ItemsControl ItemsSource="{Binding VisualKinds}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:VisualKindItem">
                <Button Classes="visualKind" Command="{Binding Add}" ToolTip.Tip="{Binding Label}">
                  <PathIcon Data="{Binding Icon}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="caption" Text="Оформление" Margin="0,10,0,4" />
          <ItemsControl ItemsSource="{Binding DesignKinds}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:VisualKindItem">
                <Button Classes="visualKind" Command="{Binding Add}" ToolTip.Tip="{Binding Label}">
                  <PathIcon Data="{Binding Icon}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="hint" IsVisible="{Binding !HasSelection}" Text="Фигура, текст и кнопка добавляются на страницу. Остальные типы — визуалы данных." />
          <TextBlock Classes="hint" IsVisible="{Binding HasSelection}" Text="Тип данных меняет выбранный визуал. Фигура, текст и кнопка всегда добавляются отдельно." />

          <!-- Поля выбранного визуала -->
          <ContentControl Content="{Binding SelectedVisual}" IsVisible="{Binding HasSelection}" Margin="0,12,0,0">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vis:VisualViewModel">
                <StackPanel Spacing="2">
                  <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,10" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="paneHeader" Text="Области полей" />
                    <TextBlock Grid.Column="1" Classes="hint" Text="{Binding KindLabel}" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                    <Button Command="{Binding Duplicate}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconCopy}" Width="12" Height="12" />
                        <TextBlock Text="Дублировать" />
                      </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconDelete}" Width="12" Height="12" />
                        <TextBlock Text="Удалить" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <TextBlock Classes="hint" Margin="0,0,0,6" IsVisible="{Binding !IsDesign}"
                             Text="Перетащите поле из панели слева в колодец или выберите из списка." />

                  <StackPanel IsVisible="{Binding !IsDesign}">
                    <TextBlock Classes="caption" Text="Заголовок" />
                    <TextBox Text="{Binding Title}" Watermark="{Binding AutoTitle}" />
                  </StackPanel>

                  <StackPanel IsVisible="{Binding IsDesign}" Margin="0,4,0,0">
                    <TextBlock Classes="caption" Text="Текст" />
                    <TextBox Text="{Binding Text}" AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap"
                             Watermark="Подпись на фигуре, кнопке или текстовом блоке" />
                    <StackPanel IsVisible="{Binding IsShape}">
                      <TextBlock Classes="caption" Text="Форма" />
                      <ComboBox ItemsSource="{Binding Shapes}" SelectedItem="{Binding Shape}" />
                    </StackPanel>
                    <TextBlock Classes="caption" Text="Выравнивание" />
                    <ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding Align}" />
                    <StackPanel IsVisible="{Binding IsButton}">
                      <TextBlock Classes="caption" Text="Действие" />
                      <ComboBox ItemsSource="{Binding DesignActions}" SelectedItem="{Binding Action}" />
                      <TextBox Text="{Binding ActionTarget}" IsVisible="{Binding ShowsActionTarget}"
                               Watermark="Имя страницы или закладки" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding ShowsDataFields}">
                  <TextBlock Classes="caption" Text="Таблица" />
                  <ComboBox ItemsSource="{Binding TableNames}" SelectedItem="{Binding Table}" />

                  <StackPanel IsVisible="{Binding ShowsCategory}" Margin="0,8,0,0">
                    <TextBlock Classes="caption" Text="{Binding CategoryCaption}" />
                    <Border Classes="fieldWell" Name="CategoryWell" Tag="category"
                            DragDrop.AllowDrop="True">
                      <Grid ColumnDefinitions="*,Auto">
                        <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding CategoryField}"
                                  PlaceholderText="Выберите поле или перетащите сюда" BorderThickness="0" Background="Transparent" />
                        <Button Grid.Column="1" Classes="icon" Margin="4,0,0,0" Command="{Binding ClearCategory}" ToolTip.Tip="Очистить">
                          <PathIcon Data="{StaticResource IconClose}" />
                        </Button>
                      </Grid>
                    </Border>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding ShowsColumnField}" Margin="0,8,0,0">
                    <TextBlock Classes="caption" Text="Столбцы" />
                    <Border Classes="fieldWell" Name="ColumnWell" Tag="column"
                            DragDrop.AllowDrop="True">
                      <Grid ColumnDefinitions="*,Auto">
                        <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding ColumnField}"
                                  PlaceholderText="Поле столбцов матрицы" BorderThickness="0" Background="Transparent" />
                        <Button Grid.Column="1" Classes="icon" Margin="4,0,0,0" Command="{Binding ClearColumnField}" ToolTip.Tip="Очистить">
                          <PathIcon Data="{StaticResource IconClose}" />
                        </Button>
                      </Grid>
                    </Border>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding ShowsGranularity}">
                    <TextBlock Classes="caption" Text="Детализация дат" />
                    <ComboBox ItemsSource="{Binding Granularities}" SelectedItem="{Binding Granularity}" />
                  </StackPanel>

                  <StackPanel IsVisible="{Binding ShowsValues}" Margin="0,8,0,0">
                    <TextBlock Classes="caption" Text="{Binding ValuesCaption}" />
                    <Border Classes="fieldWell" Name="ValuesWell" Tag="values" MinHeight="72"
                            DragDrop.AllowDrop="True">
                      <ScrollViewer MaxHeight="190">
                        <ItemsControl ItemsSource="{Binding ValueOptions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CheckItem">
                              <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" MinHeight="26" FontSize="12" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                    <TextBlock Classes="hint" Margin="0,4,0,0" Text="Отметьте поля или перетащите сюда. Можно выбрать несколько." />
                  </StackPanel>

                  <StackPanel IsVisible="{Binding ShowsAggregation}">
                    <TextBlock Classes="caption" Text="Агрегация" />
                    <ComboBox ItemsSource="{Binding Aggregations}" SelectedItem="{Binding Aggregation}" />
                  </StackPanel>

                  <StackPanel IsVisible="{Binding ShowsTopN}">
                    <TextBlock Classes="caption" Text="Показать первые N категорий (0 — все)" />
                    <NumericUpDown Value="{Binding TopN}" Minimum="0" Maximum="1000" Increment="1" FormatString="0" />
                  </StackPanel>

                  <StackPanel IsVisible="{Binding ShowsFormatting}" Margin="0,8,0,0" Spacing="4">
                    <TextBlock Classes="caption" Text="Формат" />
                    <CheckBox Content="Показывать легенду" IsChecked="{Binding ShowLegend}" FontSize="12" />
                    <CheckBox Content="Подписи данных" IsChecked="{Binding ShowDataLabels}" FontSize="12" />
                  </StackPanel>
                  </StackPanel>

                  <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,12,0,8" />
                  <TextBlock Classes="paneHeader" Text="Оформление" />
                  <WrapPanel>
                    <Button Classes="flat" Content="Светлая" Margin="0,0,4,4" Command="{Binding ApplyLookCommand}" CommandParameter="light" />
                    <Button Classes="flat" Content="Акцент" Margin="0,0,4,4" Command="{Binding ApplyLookCommand}" CommandParameter="accent" />
                    <Button Classes="flat" Content="Тёмная" Margin="0,0,4,4" Command="{Binding ApplyLookCommand}" CommandParameter="dark" />
                    <Button Classes="flat" Content="Прозрачная" Margin="0,0,4,4" Command="{Binding ApplyLookCommand}" CommandParameter="clear" />
                  </WrapPanel>
                  <WrapPanel Margin="0,4,0,0">
                    <Button Classes="swatch" Background="#FFFFFF" Command="{Binding SetFillCommand}" CommandParameter="#FFFFFF" ToolTip.Tip="Белый" />
                    <Button Classes="swatch" Background="#F3F2F1" Command="{Binding SetFillCommand}" CommandParameter="#F3F2F1" ToolTip.Tip="Серый" />
                    <Button Classes="swatch" Background="#201F1E" Command="{Binding SetFillCommand}" CommandParameter="#201F1E" ToolTip.Tip="Тёмный" />
                    <Button Classes="swatch" Background="#118DFF" Command="{Binding SetFillCommand}" CommandParameter="#118DFF" ToolTip.Tip="Синий" />
                    <Button Classes="swatch" Background="#12239E" Command="{Binding SetFillCommand}" CommandParameter="#12239E" ToolTip.Tip="Индиго" />
                    <Button Classes="swatch" Background="#107C10" Command="{Binding SetFillCommand}" CommandParameter="#107C10" ToolTip.Tip="Зелёный" />
                    <Button Classes="swatch" Background="#E6B000" Command="{Binding SetFillCommand}" CommandParameter="#E6B000" ToolTip.Tip="Жёлтый" />
                    <Button Classes="swatch" Background="#E66C37" Command="{Binding SetFillCommand}" CommandParameter="#E66C37" ToolTip.Tip="Оранжевый" />
                    <Button Classes="swatch" Background="#D64550" Command="{Binding SetFillCommand}" CommandParameter="#D64550" ToolTip.Tip="Красный" />
                    <Button Classes="swatch" Background="#744EC2" Command="{Binding SetFillCommand}" CommandParameter="#744EC2" ToolTip.Tip="Фиолетовый" />
                  </WrapPanel>
                  <TextBlock Classes="caption" Text="Заливка (#RRGGBB или transparent)" />
                  <TextBox Text="{Binding Fill}" Watermark="по умолчанию" />
                  <Grid ColumnDefinitions="*,*" >
                    <StackPanel Margin="0,0,6,0">
                      <TextBlock Classes="caption" Text="Обводка" />
                      <TextBox Text="{Binding Stroke}" Watermark="#C8C6C4" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="caption" Text="Текст" />
                      <TextBox Text="{Binding Foreground}" Watermark="#201F1E" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Classes="caption" Text="Толщина обводки" />
                  <NumericUpDown Value="{Binding StrokeThickness, Converter={StaticResource DoubleDecimal}}" Minimum="0" Maximum="24" Increment="1" FormatString="0" />
                  <TextBlock Classes="caption" Text="Скругление" />
                  <NumericUpDown Value="{Binding CornerRadius, Converter={StaticResource DoubleDecimal}}" Minimum="0" Maximum="200" Increment="1" FormatString="0" />
                  <TextBlock Classes="caption" Text="Внутренний отступ" />
                  <NumericUpDown Value="{Binding Padding, Converter={StaticResource DoubleDecimal}}" Minimum="0" Maximum="80" Increment="1" FormatString="0" />
                  <TextBlock Classes="caption" Text="Размер шрифта" />
                  <NumericUpDown Value="{Binding FontSize, Converter={StaticResource DoubleDecimal}}" Minimum="8" Maximum="96" Increment="1" FormatString="0" />
                  <CheckBox Content="Жирный" IsChecked="{Binding Bold}" FontSize="12" Margin="0,6,0,0" />
                  <CheckBox Content="Показывать заголовок" IsChecked="{Binding ShowTitle}" FontSize="12" />
                  <TextBlock Classes="caption" Text="Положение и размер" />
                  <Grid ColumnDefinitions="*,*">
                    <StackPanel Margin="0,0,6,0">
                      <TextBlock Classes="hint" Text="X" />
                      <NumericUpDown Value="{Binding X, Converter={StaticResource DoubleDecimal}}" Minimum="0" Maximum="8000" Increment="10" FormatString="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="hint" Text="Y" />
                      <NumericUpDown Value="{Binding Y, Converter={StaticResource DoubleDecimal}}" Minimum="0" Maximum="8000" Increment="10" FormatString="0" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                    <StackPanel Margin="0,0,6,0">
                      <TextBlock Classes="hint" Text="Ширина" />
                      <NumericUpDown Value="{Binding Width, Converter={StaticResource DoubleDecimal}}" Minimum="24" Maximum="4000" Increment="10" FormatString="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="hint" Text="Высота" />
                      <NumericUpDown Value="{Binding Height, Converter={StaticResource DoubleDecimal}}" Minimum="16" Maximum="4000" Increment="10" FormatString="0" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                    <Button Classes="flat" Content="Влево" Command="{Binding Owner.AlignLeftCommand}" />
                    <Button Classes="flat" Content="Вверх" Command="{Binding Owner.AlignTopCommand}" />
                    <Button Classes="flat" Content="По центру" Command="{Binding Owner.AlignCenterCommand}" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>

          <!-- Страница -->
          <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,14,0,10" />
          <TextBlock Classes="paneHeader" Text="Страница" />
          <TextBlock Classes="caption" Text="Фон (#RRGGBB)" />
          <TextBox Text="{Binding PageBackground}" Watermark="цвет темы" />
          <WrapPanel Margin="0,4,0,0">
            <Button Classes="swatch" Background="#FFFFFF" Command="{Binding SetPageBackgroundCommand}" CommandParameter="#FFFFFF" />
            <Button Classes="swatch" Background="#F3F2F1" Command="{Binding SetPageBackgroundCommand}" CommandParameter="#F3F2F1" />
            <Button Classes="swatch" Background="#E6F2FB" Command="{Binding SetPageBackgroundCommand}" CommandParameter="#E6F2FB" />
            <Button Classes="swatch" Background="#FFF8E1" Command="{Binding SetPageBackgroundCommand}" CommandParameter="#FFF8E1" />
            <Button Classes="swatch" Background="#252423" Command="{Binding SetPageBackgroundCommand}" CommandParameter="#252423" />
            <Button Classes="swatch" Background="#0F2747" Command="{Binding SetPageBackgroundCommand}" CommandParameter="#0F2747" />
          </WrapPanel>
          <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
            <StackPanel Margin="0,0,6,0">
              <TextBlock Classes="caption" Text="Ширина" />
              <NumericUpDown Value="{Binding PageWidth}" Minimum="640" Maximum="4000" Increment="20" FormatString="0" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Classes="caption" Text="Высота" />
              <NumericUpDown Value="{Binding PageHeight}" Minimum="480" Maximum="4000" Increment="20" FormatString="0" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
            <StackPanel Margin="0,0,6,0">
              <TextBlock Classes="caption" Text="Поле" />
              <NumericUpDown Value="{Binding Gap}" Minimum="0" Maximum="120" Increment="2" FormatString="0" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Classes="caption" Text="Сетка" />
              <NumericUpDown Value="{Binding GridStep}" Minimum="1" Maximum="80" Increment="1" FormatString="0" />
            </StackPanel>
          </Grid>
          <TextBlock Classes="hint" Margin="0,4,0,0" Text="Поле — отступ от края. Сетка — шаг при перетаскивании." />

          <!-- Закладки -->
          <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,14,0,10" />
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
            <TextBlock Classes="paneHeader" Text="Закладки" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="flat" Padding="6,2" Command="{Binding ResetSlicersCommand}"
                    ToolTip.Tip="Сбросить все срезы" FontSize="11" Content="Сбросить срезы" />
            <Button Grid.Column="2" Classes="flat" Padding="6,2" Command="{Binding AddBookmarkCommand}"
                    ToolTip.Tip="Сохранить текущие срезы" FontSize="11" Content="+ Закладка" />
          </Grid>
          <TextBlock Classes="hint" IsVisible="{Binding !HasBookmarks}"
                     Text="Закладка сохраняет выбранные срезы и активную страницу." />
          <ItemsControl ItemsSource="{Binding Bookmarks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ReportBookmarkItem">
                <Border Classes="chip" HorizontalAlignment="Stretch" CornerRadius="4" Margin="0,0,0,4">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Details}" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="flat" Padding="6,2" FontSize="11" Content="Применить"
                            Command="{Binding Apply}" />
                    <Button Grid.Column="2" Classes="icon" Command="{Binding Remove}" ToolTip.Tip="Удалить закладку">
                      <PathIcon Data="{StaticResource IconClose}" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Фильтры страницы -->
          <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,14,0,10" />
          <TextBlock Classes="paneHeader" Text="Фильтры страницы" />
          <TextBlock Classes="hint" IsVisible="{Binding !HasFilters}" Text="Фильтры действуют на все визуалы выбранной таблицы." />
          <ItemsControl ItemsSource="{Binding Filters}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterItemViewModel">
                <Border Classes="chip" HorizontalAlignment="Stretch" CornerRadius="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="{Binding TableText}" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" />
                      <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon" VerticalAlignment="Center" Command="{Binding Remove}" ToolTip.Tip="Убрать фильтр">
                      <PathIcon Data="{StaticResource IconClose}" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Spacing="6" IsVisible="{Binding HasData}">
            <ComboBox ItemsSource="{Binding TableNames}" SelectedItem="{Binding FilterTable}" />
            <ComboBox ItemsSource="{Binding FilterColumns}" SelectedItem="{Binding FilterColumn}" PlaceholderText="Столбец" />
            <ComboBox ItemsSource="{Binding FilterOperators}" SelectedItem="{Binding SelectedOperator}" />
            <TextBox Text="{Binding FilterValue}" Watermark="Значение" IsEnabled="{Binding FilterNeedsValue}" />
            <Button HorizontalAlignment="Stretch" Command="{Binding AddFilterCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconFilter}" Width="14" Height="14" />
                <TextBlock Text="Добавить фильтр" />
              </StackPanel>
            </Button>
            <Border Classes="error" IsVisible="{Binding FilterError, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding FilterError}" />
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
